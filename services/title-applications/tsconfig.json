{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "types": ["../../web/node_modules/@cloudflare/workers-types", "../../web/node_modules/@types/react", "../../web/node_modules/@types/react-dom"],
    "baseUrl": ".", "paths": { "react": ["../../web/node_modules/@types/react"], "react/*": ["../../web/node_modules/@types/react/*"], "react-dom/*": ["../../web/node_modules/@types/react-dom/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "worker-configuration.d.ts", "secrets.d.ts"]
}
