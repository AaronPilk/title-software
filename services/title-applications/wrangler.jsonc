{
  "$schema": "../../web/node_modules/wrangler/config-schema.json",
  "name": "title-applications",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  "vars": { "JV_PUBLIC_ENDPOINT": "https://yhneskzvmtcmbsknidlt.supabase.co/functions/v1/title-jv-public" },
  "ratelimits": [{ "name": "PORTAL_REQUESTS", "namespace_id": "202609241", "simple": { "limit": 90, "period": 60 } }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
