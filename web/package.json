{
  "name": "titleos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "build:pilot": "node scripts/cloudflare-pilot.mjs build",
    "deploy:pilot": "node scripts/cloudflare-pilot.mjs deploy",
    "check:pilot": "node scripts/cloudflare-pilot.mjs dry-run",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node scripts/test-domain.mjs",
    "typecheck": "tsc --noEmit",
    "backend:build": "node scripts/backend/build.mjs",
    "test:backend": "node scripts/backend/test.mjs",
    "test:api": "node scripts/backend/test-api.mjs",
    "test:missive:ui": "node scripts/test-missive-settings-ui.mjs",
    "test:workspace:ui": "node scripts/test-workspace-refresh.mjs",
    "test:cloud": "node scripts/backend/test-cloud.mjs",
    "test:missive": "node scripts/backend/test-missive.mjs",
    "test:missive:sql": "node scripts/backend/test-missive-sql.mjs",
    "test:pdf": "node scripts/test-pdf-text.mjs",
    "test:workflows": "node --experimental-strip-types --test tests/finals-workflow.test.mjs tests/member-directory.test.mjs tests/overview.test.mjs tests/partner-summary.test.mjs",
    "test:assistant": "npm --prefix ../services/title-assistant test",
    "ocr:prepare": "node scripts/prepare-ocr-assets.mjs",
    "predev": "npm run ocr:prepare",
    "prebuild": "npm run ocr:prepare",
    "prebuild:pilot": "npm run ocr:prepare",
    "test:ocr": "node scripts/test-local-ocr.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "2.116.0",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "1.63.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
